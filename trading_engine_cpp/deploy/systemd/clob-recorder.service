# systemd unit: runs clob_ws permanently on the recording server.
#
# Install (on the server):
#   sudo install -m 644 clob-recorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now clob-recorder
#
# Watch:
#   systemctl status clob-recorder
#   journalctl -u clob-recorder -f
#
# Same layout and settings as binance-recorder.service - see that file
# for the reasoning behind each one.
#
# Comments must be on their own line: systemd would read anything after
# "=" on the same line, including a "#", as part of the value.

[Unit]
Description=Polymarket CLOB BTC 5m order book recorder
Documentation=https://github.com/Stepan-Letsko/polymarket-btc-trading-engine/blob/main/trading_engine_cpp/docs/programs.md

# Network up and clock synced first (needs chrony-wait.service enabled).
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

# 5 failures within 10 minutes: stop retrying and mark it "failed".
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=polyrecorder
Group=polyrecorder

# Looks up the current market via Polymarket's Gamma API at startup
# (retrying every 3s until it gets one) and switches market every 5
# minutes by itself.
ExecStart=/opt/polyrecorder/bin/clob_ws --out-dir /var/lib/polyrecorder/data

# Restart 2 seconds after the process dies; network problems are handled
# inside the recorder.
Restart=always
RestartSec=2

# SIGTERM -> close, write the queue, exit. Up to 30 seconds.
TimeoutStopSec=30

# New files: owner writes, group reads, others nothing.
UMask=0027

# --- Lock-down ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/polyrecorder/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
