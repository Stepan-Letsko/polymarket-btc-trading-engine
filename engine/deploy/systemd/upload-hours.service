# systemd unit: one pass of upload_hours - uploads compressed hourly
# recordings to Google Cloud Storage, and deletes local copies the bucket
# is proven to hold once they're 7 days old. Started every 10 minutes by
# upload-hours.timer.
#
# Needs, on the server (see docs/deployment.md, sections 6 and 8):
#   - the script:   sudo install -o root -g root -m 755 upload_hours.sh /opt/polyrecorder/bin/upload_hours
#   - gcloud, curl, jq and the AWS -> Google settings file
#     /etc/polyrecorder/gcs-wif.json
#   - /etc/polyrecorder/upload-hours.env, one line: BUCKET=<bucket name>
#     (kept on the server, so the bucket name isn't in the repo)
#
# Install, together with the timer:
#   sudo install -m 644 upload-hours.service upload-hours.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now upload-hours.timer
#
# Watch:
#   systemctl list-timers upload-hours.timer   (last and next run)
#   journalctl -u upload-hours                 (what each pass did)
#
# Comments must be on their own line: systemd would read anything after
# "=" on the same line, including a "#", as part of the value.

[Unit]
Description=Upload compressed recordings to Google Cloud Storage
Documentation=https://github.com/Stepan-Letsko/polymarket-btc-trading-engine/blob/main/engine/docs/deployment.md

# Every pass needs the network; don't start one before it's up.
Wants=network-online.target
After=network-online.target

[Service]
# A job that runs once and exits, like compress-hours.
Type=oneshot

User=polyrecorder
Group=polyrecorder

# BUCKET=<bucket name>
EnvironmentFile=/etc/polyrecorder/upload-hours.env

# The AWS -> Google settings file lives in /etc/polyrecorder, which this
# account can't enter. systemd (as root) reads it at start and puts a copy
# in a private folder only this service can see; %d is that folder.
LoadCredential=gcs-wif.json:/etc/polyrecorder/gcs-wif.json
Environment=CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE=%d/gcs-wif.json

# gcloud insists on a writable folder for its own settings and logs.
# systemd creates /var/cache/polyrecorder-gcloud for it (%C = /var/cache),
# owned by this account; everything else stays read-only.
CacheDirectory=polyrecorder-gcloud
Environment=CLOUDSDK_CONFIG=%C/polyrecorder-gcloud

# Unattended: never wait for an answer to a question, and don't check for
# gcloud updates (apt upgrade handles those).
Environment=CLOUDSDK_CORE_DISABLE_PROMPTS=1
Environment=CLOUDSDK_COMPONENT_MANAGER_DISABLE_UPDATE_CHECK=1

ExecStart=/opt/polyrecorder/bin/upload_hours --data-dir /var/lib/polyrecorder/data --bucket ${BUCKET} --keep-days 7

# A pass normally takes seconds (the very first, a few minutes). If gcloud
# ever hangs, stop it after an hour so the timer's next pass can run.
TimeoutStartSec=1h

# No Restart=: a failed pass (exit 1) is retried by the next one 10
# minutes later, and shows in "systemctl status upload-hours" meanwhile.

# --- Lowest priority, so uploading never slows the recorders ---
CPUSchedulingPolicy=idle
Nice=19
IOSchedulingClass=idle

# gcloud is a Python program: a few hundred MB at most.
MemoryMax=1G

# New files (the lock): owner writes, group reads, others nothing.
UMask=0027

# --- Lock-down, as for the recorders ---
NoNewPrivileges=yes
ProtectSystem=strict
# Deleting uploaded files and the lock file; gcloud's cache folder is
# made writable by CacheDirectory= above.
ReadWritePaths=/var/lib/polyrecorder/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
